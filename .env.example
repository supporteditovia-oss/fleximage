# App
NODE_ENV=development
PORT=5000
# Local only — production always uses https://www.luxeflexia.com
APP_URL=http://localhost:5000
# Public site URL for robots.txt / sitemap.xml / Stripe / OAuth fallbacks
SITE_URL=https://www.luxeflexia.com
LOG_LEVEL=info
# Optional: force auth redirect origin (otherwise window.location.origin is used)
# VITE_PUBLIC_APP_URL=https://www.luxeflexia.com
#
# Supabase Dashboard → Authentication → URL Configuration:
#   Site URL: https://www.luxeflexia.com (prod) — do NOT leave localhost or Replit
#   Redirect URLs (required for Google OAuth):
#     http://localhost:5000/**
#     http://127.0.0.1:5000/**
#     https://www.luxeflexia.com/**
#     https://luxeflexia.com/**
# Google OAuth (custom client — required for LuxeFlexIA on Google's login screen)
# Supabase's default shared client shows *.supabase.co instead of LuxeFlexIA.
# Create a Web OAuth client in Google Cloud (Branding: LuxeFlexIA + logo), then run:
#   npm run auth:google-oauth
# GOOGLE_OAUTH_CLIENT_ID=....apps.googleusercontent.com
# GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-...
# SUPABASE_ACCESS_TOKEN=sbp_...  (Dashboard → Account → Access Tokens)
#
# Google Cloud → OAuth 2.0 Client (Web):
#   Authorized JavaScript origins: http://localhost:5000 , https://www.luxeflexia.com , https://luxeflexia.com
#   Authorized redirect URIs: https://dktplzbpwevyhroituys.supabase.co/auth/v1/callback

# Supabase
# Public browser key. Safe to expose to the client.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Server-only key. Never expose this in client code.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Stripe
# Use a REAL secret key from Stripe Dashboard → Developers → API keys
# Must match price mode: sk_test_... with test prices, sk_live_... with live prices
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
STRIPE_WEBHOOK_ENDPOINT_ID=
STRIPE_WEBHOOK_URL=https://your-domain.example.com/api/stripe/webhook
# Live monthly plans (EUR) — keep mapped 1:1 with server/lib/stripe.ts credits
# Découverte 8,90€ → 250 crédits/mois
STRIPE_DISCOVERY_PRICE_ID=price_1TuYXR46E9Di7XBgxmpSdu7s
# Essentiel 19,90€ → 850 + 250 offerts = 1100 crédits/mois
STRIPE_ESSENTIAL_PRICE_ID=price_1TuYcG46E9Di7XBgdktOd6cg
# Ultimate 39,90€ → 2500 crédits/mois
STRIPE_ULTIMATE_PRICE_ID=price_1TuYdI46E9Di7XBg8wLEuogs

# One-shot credit packs (Boost) — create via: npx tsx script/create-stripe-credit-packs.ts
STRIPE_PACK_MINI_PRICE_ID=
STRIPE_PACK_STANDARD_PRICE_ID=
STRIPE_PACK_PLUS_PRICE_ID=

# Stripe legacy / fallback price ids
# Keep empty unless you need compatibility with old plans.
STRIPE_PRICE_ID=
STRIPE_IMAGE_PRICE_ID=
STRIPE_VIDEO_PRICE_ID=
STRIPE_WEEKLY_PRICE_ID=
STRIPE_MONTHLY_PRICE_ID=
STRIPE_WEEKLY_LEGACY_PRICE_IDS=
STRIPE_MONTHLY_LEGACY_PRICE_IDS=
STRIPE_IMAGE_LEGACY_PRICE_IDS=
STRIPE_VIDEO_LEGACY_PRICE_IDS=

# Cloudflare R2
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=your_r2_bucket_name
R2_PUBLIC_URL=https://your-public-r2-domain.example.com

# AI providers
KIE_AI_API_KEY=your_kie_ai_api_key
ONESHOT_API_URL=https://api.oneshot.example
ONESHOT_API_KEY=your_oneshot_api_key

# Fish Audio — voice clone + TTS (server-only)
# Get key: https://fish.audio/app/api-keys
# s2.1-pro-free = gratuit (qualité limitée) · s2.1-pro = meilleure fidélité (payant)
FISH_AUDIO_API_KEY=
FISH_AUDIO_MODEL=s2.1-pro

# Post-generation vision QA (auto-retry on critical AI artifacts).
# Prefer Gemini (free tier at Google AI Studio). OpenAI also supported.
# Leave empty to skip QA (generations still work). Set VISION_QA_ENABLED=0 to force-disable.
GEMINI_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=
# OPENAI_API_KEY=
# GEMINI_VISION_MODEL=gemini-2.0-flash
# VISION_QA_ENABLED=1

# Snap Pixel / Conversions API
# Browser pixel (Vite public). Leave empty until Ads Manager pixel is ready.
VITE_SNAP_PIXEL_ID=
# Server-side CAPI (PURCHASE from Stripe webhook only). Never expose the token.
SNAP_PIXEL_ID=
SNAP_CAPI_TOKEN=

# V2 admin preview — comma-separated IPs allowed to see V2 (admin account required too).
# Example: V2_PREVIEW_IP_ALLOWLIST=203.0.113.42,198.51.100.7
# Discover your IP after deploy: GET https://www.luxeflexia.com/api/v2-access
V2_PREVIEW_IP_ALLOWLIST=

# Dashboard Discord → channel → Integrations → Webhooks
DISCORD_WEBHOOK_URL=
