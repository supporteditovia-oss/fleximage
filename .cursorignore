dist/
build/
.next/
out/
coverage/
.turbo/
.vercel/
.git/
*.lock
package-lock.json
yarn.lock
pnpm-lock.yaml
*.min.js
*.min.css
*.map
*.log
__pycache__/
*.pyc
.DS_Store
